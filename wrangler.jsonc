{
  "name": "rock-solid-leveling",
  "main": "_worker.js",
  "compatibility_date": "2026-04-28",
  "assets": {
    "directory": "./dist"
  },
  "vars": {
    "QUOTE_NOTIFICATION_EMAILS": "blake@rocksolidleveling.com"
  },
  "send_email": [
    {
      "name": "QUOTE_NOTIFICATION_EMAIL",
      "allowed_sender_addresses": [
        "quotes@go.rocksolidleveling.com"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUOTE_IMAGES_BUCKET",
      "bucket_name": "quote-images"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
