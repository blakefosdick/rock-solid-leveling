# Browser-side form target. For Cloudflare Pages Functions in this repo, use:
VITE_N8N_FORM_ID=rock-solid-website

# Public website analytics. Use a PostHog project dedicated to rock-solid-leveling.
# These VITE_ values are baked into the static bundle at build time.
# Cloudflare Worker runtime vars in wrangler.jsonc do not inject them into Vite builds.
VITE_POSTHOG_KEY=phc_YOUR_PUBLIC_SITE_PROJECT_KEY
VITE_POSTHOG_HOST=https://records.rocksolidleveling.com
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# Public browser Meta Pixel. The Pixel ID is safe to expose in the Vite bundle.
VITE_META_PIXEL_ID=YOUR_META_PIXEL_ID

# Cloudflare Pages Function bindings/secrets (set in Cloudflare dashboard or wrangler):
# R2 binding name: QUOTE_IMAGES_BUCKET
# Email binding name: QUOTE_NOTIFICATION_EMAIL
# Secret: HIGHLEVEL_API_TOKEN
# Vars: HIGHLEVEL_LOCATION_ID, HIGHLEVEL_SLABS_FIELD_ID, HIGHLEVEL_IMAGES_FIELD_ID, HIGHLEVEL_NOTES_FIELD_ID
# Optional: IMAGE_PUBLIC_BASE_URL. Leave unset to use same-origin /quote-images/... Worker URLs.
QUOTE_NOTIFICATION_EMAILS=blake@rocksolidleveling.com

# Google Business Profile reviews feed.
# Keep this false until Google approves GBP API access, then set it to true.
GOOGLE_REVIEWS_ENABLED=false
VITE_GOOGLE_REVIEWS_ENABLED=false
#
# Store these as Cloudflare/Wrangler secrets, not committed env vars:
# GOOGLE_BUSINESS_PROFILE_CLIENT_ID
# GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET
# GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN
#
# Store the Business Profile ID/location ID as a non-secret Cloudflare/Wrangler var.
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=YOUR_BUSINESS_PROFILE_ID
#
# If you have the full resource name, you can use this instead:
# GOOGLE_BUSINESS_PROFILE_LOCATION_NAME=accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID

# Meta Conversions API is sent server-side by the Cloudflare Worker.
# Do not expose the access token through VITE_ browser variables.
# Cloudflare/Wrangler var:
META_PIXEL_ID=YOUR_META_PIXEL_ID
META_CAPI_GRAPH_VERSION=v25.0
# Optional Cloudflare/Wrangler var while validating in Meta Events Manager:
META_TEST_EVENT_CODE=TEST12345
# Cloudflare/Wrangler secret:
# META_CAPI_ACCESS_TOKEN
